{
  "name": "electron-chrome-extension-lab",
  "private": true,
  "version": "0.0.1",
  "description": "Compatibility lab for production Chrome extensions in Electron",
  "main": "main.js",
  "scripts": {
    "fetch-extensions": "node scripts/fetch-extensions.mjs",
    "start": "electron .",
    "start:shim": "electron . --extension-provider=shim",
    "smoke": "electron . --smoke",
    "smoke:shim": "electron . --smoke --extension-provider=shim",
    "platform:update": "node scripts/generate-platform-contract.mjs",
    "platform:freshness": "node scripts/check-platform-freshness.mjs",
    "platform:freshness:strict": "node scripts/check-platform-freshness.mjs --strict",
    "platform:check": "node scripts/check-platform-coverage.mjs",
    "platform:check:linux": "node scripts/check-platform-coverage.mjs --platform linux --strict",
    "platform:check:win": "node scripts/check-platform-coverage.mjs --platform win --strict",
    "platform:check:strict": "node scripts/check-platform-coverage.mjs --strict",
    "oracle:generate": "node scripts/generate-oracle-probes.mjs",
    "oracle:run": "node scripts/run-chromium-oracle.mjs",
    "test:platform": "node scripts/test-platform-contract.mjs",
    "test:oracle": "node scripts/test-oracle.mjs"
  },
  "devDependencies": {
    "adm-zip": "0.6.0",
    "electron": "43.1.0",
    "electron-chrome-extensions": "4.9.0"
  }
}
