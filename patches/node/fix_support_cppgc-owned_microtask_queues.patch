From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cmux-lawrence <cmux-lawrence@cmux-lawrences-Mac-mini.local>
Date: Sun, 12 Jul 2026 23:40:12 -0700
Subject: fix: support cppgc-owned microtask queues

V8_CPPGC_MICROTASK_QUEUE changes MicrotaskQueue::New() from unique ownership to a cppgc-managed raw pointer. Keep the queue alive with cppgc::Persistent in that configuration while preserving std::unique_ptr for Node's default V8 build.

diff --git a/src/node_contextify.cc b/src/node_contextify.cc
index 808e28db0f4c1d410fdf97013eaa65ed0c15fd78..29506dd942d24ce49f59ed06185a83fffccfe7c9 100644
--- a/src/node_contextify.cc
+++ b/src/node_contextify.cc
@@ -127,7 +127,7 @@ ContextifyContext* ContextifyContext::New(Environment* env,
 
   MicrotaskQueue* queue =
       options->own_microtask_queue
-          ? options->own_microtask_queue.get()
+          ? GetOwnedMicrotaskQueue(options->own_microtask_queue)
           : env->isolate()->GetCurrentContext()->GetMicrotaskQueue();
 
   Local<Context> v8_context;
@@ -148,9 +148,7 @@ ContextifyContext::ContextifyContext(Environment* env,
                                      Local<Object> wrapper,
                                      Local<Context> v8_context,
                                      ContextOptions* options)
-    : microtask_queue_(options->own_microtask_queue
-                           ? options->own_microtask_queue.release()
-                           : nullptr) {
+    : microtask_queue_(std::move(options->own_microtask_queue)) {
   CppgcMixin::Wrap(this, env, wrapper);
 
   context_.Reset(env->isolate(), v8_context);
diff --git a/src/node_contextify.h b/src/node_contextify.h
index 1066633daf65d430b5f46e1b226ee3cf70979c33..b809022c95478897e4fb9703dbeb929c8ac06332 100644
--- a/src/node_contextify.h
+++ b/src/node_contextify.h
@@ -13,12 +13,30 @@ class ExternalReferenceRegistry;
 
 namespace contextify {
 
+// V8's cppgc microtask queue mode transfers lifetime management to cppgc.
+// Keep a persistent root in that mode and retain unique ownership otherwise.
+#ifdef V8_CPPGC_MICROTASK_QUEUE
+using OwnedMicrotaskQueue = cppgc::Persistent<v8::MicrotaskQueue>;
+
+inline v8::MicrotaskQueue* GetOwnedMicrotaskQueue(
+    const OwnedMicrotaskQueue& queue) {
+  return queue.Get();
+}
+#else
+using OwnedMicrotaskQueue = std::unique_ptr<v8::MicrotaskQueue>;
+
+inline v8::MicrotaskQueue* GetOwnedMicrotaskQueue(
+    const OwnedMicrotaskQueue& queue) {
+  return queue.get();
+}
+#endif  // V8_CPPGC_MICROTASK_QUEUE
+
 struct ContextOptions {
   v8::Local<v8::String> name;
   v8::Local<v8::String> origin;
   v8::Local<v8::Boolean> allow_code_gen_strings;
   v8::Local<v8::Boolean> allow_code_gen_wasm;
-  std::unique_ptr<v8::MicrotaskQueue> own_microtask_queue;
+  OwnedMicrotaskQueue own_microtask_queue;
   v8::Local<v8::Symbol> host_defined_options_id;
   bool vanilla = false;
 };
@@ -122,7 +140,7 @@ class ContextifyContext final : CPPGC_MIXIN(ContextifyContext) {
   }
 
   inline v8::MicrotaskQueue* microtask_queue() const {
-    return microtask_queue_.get();
+    return GetOwnedMicrotaskQueue(microtask_queue_);
   }
 
   template <typename T>
@@ -186,7 +204,7 @@ class ContextifyContext final : CPPGC_MIXIN(ContextifyContext) {
       const v8::PropertyCallbackInfo<v8::Array>& args);
 
   v8::TracedReference<v8::Context> context_;
-  std::unique_ptr<v8::MicrotaskQueue> microtask_queue_;
+  OwnedMicrotaskQueue microtask_queue_;
 };
 
 class ContextifyScript final : CPPGC_MIXIN(ContextifyScript) {
