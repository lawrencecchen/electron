From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michal Pichlinski <michal.pichlinski@openfin.co>
Date: Thu, 15 Jun 2023 23:04:48 +0200
Subject: allow disabling throttling in the `viz::DisplayScheduler` per
 `ui::Compositor`

In Chromium when the `viz::DisplayScheduler` is invisible it throttles
its work by dropping frame draws and swaps.

This patch allows disbling this throttling by preventing transition to
invisible state of the `viz::DisplayScheduler` owned
by the `ui::Compositor`.

diff --git a/ui/compositor/compositor.cc b/ui/compositor/compositor.cc
index 752e86c98be7eb6a69137e2015340fb218950bb9..593330cece237493a650a8e5dde5819e8093c35c 100644
--- a/ui/compositor/compositor.cc
+++ b/ui/compositor/compositor.cc
@@ -367,7 +367,10 @@ void Compositor::SetLayerTreeFrameSink(
   // to match the Compositor's.
   if (display_private_) {
     display_private_->Resize(size());
-    display_private_->SetDisplayVisible(host_->IsVisible());
+    // Viz throttles invisible displays. Keep this one visible when Electron
+    // disables background throttling.
+    display_private_->SetDisplayVisible(!background_throttling_ ||
+                                        host_->IsVisible());
     display_private_->SetDisplayColorSpaces(display_color_spaces_);
     display_private_->SetDisplayColorMatrix(
         gfx::SkM44ToTransform(display_color_matrix_));
@@ -592,8 +595,9 @@ void Compositor::SetVisible(bool visible) {
   // Visibility is reset when the output surface is lost, so this must also be
   // updated then. We need to call this even if the visibility hasn't changed,
   // for the same reason.
-  if (display_private_)
-    display_private_->SetDisplayVisible(visible);
+  if (display_private_) {
+    display_private_->SetDisplayVisible(!background_throttling_ || visible);
+  }

   if (changed) {
     observer_list_.Notify(&CompositorObserver::OnCompositorVisibilityChanged,
@@ -1061,6 +1065,14 @@ void Compositor::MaybeUpdateObserveBeginFrame() {
       host_begin_frame_observer_->GetBoundRemote());
 }

+void Compositor::SetBackgroundThrottling(bool background_throttling_enabled) {
+  background_throttling_ = background_throttling_enabled;
+  if (display_private_) {
+    display_private_->SetDisplayVisible(!background_throttling_ ||
+                                        host_->IsVisible());
+  }
+}
+
 #if BUILDFLAG(IS_CHROMEOS)
 void Compositor::SetSeamlessRefreshRates(
     const std::vector<float>& seamless_refresh_rates) {
diff --git a/ui/compositor/compositor.h b/ui/compositor/compositor.h
index f5db8cc34d55199673b9990237ffd9e2f2024f6a..5e1476fb5f05710a766f2d58cf64ff1353060342 100644
--- a/ui/compositor/compositor.h
+++ b/ui/compositor/compositor.h
@@ -504,6 +504,9 @@ class COMPOSITOR_EXPORT Compositor

   const cc::LayerTreeSettings& GetLayerTreeSettings() const;

+  // Controls whether an invisible display suspends drawing and frame swaps.
+  void SetBackgroundThrottling(bool background_throttling_enabled);
+
   size_t saved_events_metrics_count_for_testing() const {
     return host_->saved_events_metrics_count_for_testing();
   }
@@ -720,6 +723,10 @@ class COMPOSITOR_EXPORT Compositor
   // See go/report-ux-metrics-at-painting for details.
   bool animation_started_ = false;

+  // Chromium normally throttles an invisible display. When disabled, keep
+  // |display_private_| visible so it continues generating frames.
+  bool background_throttling_ = true;
+
   TrackerId next_compositor_metrics_tracker_id_ = 1u;
   struct TrackerState {
     TrackerState();
