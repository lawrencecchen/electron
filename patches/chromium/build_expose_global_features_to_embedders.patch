From 0344a525f98a2badbe280ff830fa4e7ff522b84c Mon Sep 17 00:00:00 2001
From: cmux-lawrence <cmux-lawrence@cmux-lawrences-Mac-mini.local>
Date: Sat, 11 Jul 2026 18:58:14 -0700
Subject: [PATCH] build: expose GlobalFeatures to embedders

---
 chrome/browser/BUILD.gn | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index 56c1cf679..9fb1211f9 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -869,0 +870,10 @@ source_set("core") {
+  if (enable_electron_chrome_profile_runtime) {
+    # Electron supplies its BrowserProcessImpl and links GlobalFeatures through
+    # the embeddable archive below. Keeping these implementations out of the
+    # Chrome core source set prevents duplicate process owners.
+    sources -= [
+      "browser_process_impl.cc",
+      "global_features.cc",
+    ]
+  }
+
@@ -1954,0 +1965,26 @@ source_set("core") {
+if (enable_electron_chrome_profile_runtime) {
+  # GlobalFeatures historically lives inside the //chrome/browser:core
+  # monolith. Electron needs the real GlobalFeatures and
+  # GlobalBrowserCollection ownership graph without Chrome's BrowserProcessImpl.
+  # Archiving the browser aggregation keeps the existing implementation
+  # dependencies while letting the final link extract only the objects
+  # reachable from global_features.cc.
+  static_library("global_features_embedder_impl") {
+    sources = [ "global_features.cc" ]
+    complete_static_lib = true
+    check_includes = false
+
+    configs += [
+      "//build/config/compiler:wexit_time_destructors",
+      "//build/config:precompiled_headers",
+    ]
+    defines = [ "ZLIB_CONST" ]
+
+    if (is_chrome_branded || use_official_enterprise_connectors_api_keys) {
+      defines += [ "USE_OFFICIAL_ENTERPRISE_CONNECTORS_API_KEYS=1" ]
+    }
+
+    deps = [ ":browser" ]
+  }
+}
+
