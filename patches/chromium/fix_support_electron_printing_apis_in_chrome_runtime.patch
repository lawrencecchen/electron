   set_analyzing_content(/*analyzing=*/true);
 #endif
   content::GlobalRenderFrameHostId id = CurrentTargetFrame().GetGlobalId();
@@ -632,7 +629,7 @@ void PrintViewManager::OnRequestPrintPreviewCallback(
