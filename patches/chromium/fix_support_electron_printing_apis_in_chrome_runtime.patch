     content::GlobalRenderFrameHostId rfh_id,
     bool should_proceed) {
-#if BUILDFLAG(ENTERPRISE_CONTENT_ANALYSIS)
+#if 0  // Electron does not support Chrome enterprise print content analysis.
   set_analyzing_content(/*analyzing=*/false);
 #endif
