diff --git a/chrome/browser/process_singleton_startup_lock.cc b/chrome/browser/process_singleton_startup_lock.cc
index 6b64b9f72aa93e9f9bf22e1601a0f79d7aff8144..50bec1ddce755d43088cadddafea1e8edeb25240 100644
--- a/chrome/browser/process_singleton_startup_lock.cc
+++ b/chrome/browser/process_singleton_startup_lock.cc
@@ -35,7 +35,8 @@ void ProcessSingletonStartupLock::Unlock() {
        it != saved_startup_messages_.end(); ++it) {
     if (replayed_messages.find(*it) != replayed_messages.end())
       continue;
-    original_callback_.Run(base::CommandLine(it->first), it->second);
+    original_callback_.Run(base::CommandLine(std::get<0>(*it)),
+                           std::get<1>(*it), std::get<2>(*it));
     replayed_messages.insert(*it);
   }
   saved_startup_messages_.clear();
@@ -43,14 +44,16 @@ void ProcessSingletonStartupLock::Unlock() {
 
 bool ProcessSingletonStartupLock::NotificationCallbackImpl(
     base::CommandLine command_line,
-    const base::FilePath& current_directory) {
+    const base::FilePath& current_directory,
+    std::vector<uint8_t> additional_data) {
   if (locked_) {
     // If locked, it means we are not ready to process this message because
     // we are probably in a first run critical phase.
-    saved_startup_messages_.push_back(
-        std::make_pair(command_line.argv(), current_directory));
+    saved_startup_messages_.emplace_back(
+        command_line.argv(), current_directory, std::move(additional_data));
     return true;
   } else {
-    return original_callback_.Run(std::move(command_line), current_directory);
+    return original_callback_.Run(std::move(command_line), current_directory,
+                                  std::move(additional_data));
   }
 }
