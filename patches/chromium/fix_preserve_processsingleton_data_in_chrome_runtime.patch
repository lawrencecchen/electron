From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lawrence Chen <lawrence@manaflow.com>
Date: Mon, 13 Jul 2026 11:26:02 +0000
Subject: fix: preserve ProcessSingleton data in Chrome runtime


diff --git a/chrome/browser/chrome_browser_main.cc b/chrome/browser/chrome_browser_main.cc
index 570f788355f25cdd22ef86f5974c89efce76ce43..518547d0fc6b7bee5ae55f398c530ef75ae0a6c7 100644
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -524,7 +524,8 @@ void ProcessSingletonNotificationCallbackImpl(
 // (i.e., because the current process is shutting down).
 bool ProcessSingletonNotificationCallback(
     base::CommandLine command_line,
-    const base::FilePath& current_directory) {
+    const base::FilePath& current_directory,
+    std::vector<uint8_t> /*additional_data*/) {
   // Drop the request if the browser process is already shutting down.
   // Note that we're going to post an async task below. Even if the browser
   // process isn't shutting down right now, it could be by the time the task
@@ -2302,6 +2303,7 @@ std::unique_ptr<base::RunLoop> ChromeBrowserMainParts::TakeRunLoopForTest() {
 bool ChromeBrowserMainParts::ProcessSingletonNotificationForTesting(
     base::CommandLine command_line) {
   return ProcessSingletonNotificationCallback(command_line,
-                                              /*current_directory=*/{});
+                                              /*current_directory=*/{},
+                                              /*additional_data=*/{});
 }
 #endif  // BUILDFLAG(ENABLE_PROCESS_SINGLETON)
diff --git a/chrome/browser/chrome_process_singleton.cc b/chrome/browser/chrome_process_singleton.cc
index 4e1b0de17710092074a7eb68bc6260eb5edfb66d..87a52658d7ef9dc2c469a2402e6084f509ab3f6d 100644
--- a/chrome/browser/chrome_process_singleton.cc
+++ b/chrome/browser/chrome_process_singleton.cc
@@ -28,8 +28,15 @@ ChromeProcessSingleton::ChromeProcessSingleton(
     : startup_lock_(
           base::BindRepeating(&ChromeProcessSingleton::NotificationCallback,
                               base::Unretained(this))),
-      process_singleton_(user_data_dir,
-                         startup_lock_.AsNotificationCallback()) {}
+      process_singleton_(
+#if BUILDFLAG(IS_WIN)
+          "Chrome",
+#endif
+          user_data_dir, {},
+#if BUILDFLAG(IS_WIN)
+          /*is_app_sandboxed=*/false,
+#endif
+          startup_lock_.AsNotificationCallback()) {}
 
 ChromeProcessSingleton::~ChromeProcessSingleton() = default;
 
@@ -137,7 +144,9 @@ bool ChromeProcessSingleton::IsSingletonInstance() {
 
 bool ChromeProcessSingleton::NotificationCallback(
     base::CommandLine command_line,
-    const base::FilePath& current_directory) {
+    const base::FilePath& current_directory,
+    std::vector<uint8_t> additional_data) {
   DCHECK(notification_callback_);
-  return notification_callback_.Run(std::move(command_line), current_directory);
+  return notification_callback_.Run(std::move(command_line), current_directory,
+                                    std::move(additional_data));
 }
