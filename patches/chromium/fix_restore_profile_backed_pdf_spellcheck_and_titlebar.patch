+#include "chrome/common/buildflags.h"
 #include "chrome/grit/pdf_resources.h"
 #include "components/pdf/browser/pdf_stream_delegate.h"
 #include "components/prefs/pref_service.h"
@@ -46,7 +47,7 @@ namespace {
 // hierarchy is: enterprise policy > user choice > finch experiment.
 bool ShouldEnableSkiaRenderer(content::WebContents* contents) {
   CHECK(contents);
-#if 0
+#if BUILDFLAG(ENABLE_ELECTRON_CHROME_PROFILE_RUNTIME)
   const PrefService* prefs =
       Profile::FromBrowserContext(contents->GetBrowserContext())->GetPrefs();
 
@@ -66,7 +67,7 @@ bool ShouldEnableSkiaRenderer(content::WebContents* contents) {
 // priority hierarchy is: enterprise policy > user choice > finch experiment.
 bool ShouldEnableXfaForms(content::WebContents* contents) {
   CHECK(contents);
-#if 0
+#if BUILDFLAG(ENABLE_ELECTRON_CHROME_PROFILE_RUNTIME)
   const PrefService* prefs =
       Profile::FromBrowserContext(contents->GetBrowserContext())->GetPrefs();
 
diff --git a/chrome/browser/pdf/pdf_extension_util.cc b/chrome/browser/pdf/pdf_extension_util.cc
index dfdfd0fc5b438..a18c13829da52 100644
--- a/chrome/browser/pdf/pdf_extension_util.cc
+++ b/chrome/browser/pdf/pdf_extension_util.cc
@@ -16,6 +16,10 @@
 #include "build/branding_buildflags.h"
 #include "build/build_config.h"
 #include "chrome/browser/browser_process.h"
+#include "chrome/common/buildflags.h"
+#if BUILDFLAG(ENABLE_ELECTRON_CHROME_PROFILE_RUNTIME)
+#include "chrome/browser/glic/public/glic_enabling.h"
+#endif
 #include "chrome/common/chrome_features.h"
 #include "chrome/common/extensions/api/pdf_viewer_private.h"
 #include "chrome/common/url_constants.h"
@@ -52,9 +56,10 @@
 #include "components/prefs/pref_service.h"
 #endif  // BUILDFLAG(ENABLE_PDF_INK2)
 
-#if BUILDFLAG(ENABLE_PDF_INK2) || BUILDFLAG(ENABLE_PDF_SAVE_TO_DRIVE)
+#if BUILDFLAG(ENABLE_ELECTRON_CHROME_PROFILE_RUNTIME) || \
+    BUILDFLAG(ENABLE_PDF_INK2) || BUILDFLAG(ENABLE_PDF_SAVE_TO_DRIVE)
 #include "chrome/browser/profiles/profile.h"
-#endif  // BUILDFLAG(ENABLE_PDF_INK2) || BUILDFLAG(ENABLE_PDF_SAVE_TO_DRIVE)
+#endif
 
 namespace pdf_extension_util {
 
@@ -270,13 +275,14 @@ bool IsPrintingEnabled(content::BrowserContext* context) {
 
 #if BUILDFLAG(ENABLE_PDF_INK2)
 bool IsPdfAnnotationsEnabledByPolicy(content::BrowserContext* context) {
-# if 0
+#if BUILDFLAG(ENABLE_ELECTRON_CHROME_PROFILE_RUNTIME)
   PrefService* prefs =
       context ? Profile::FromBrowserContext(context)->GetPrefs() : nullptr;
   return !prefs || !prefs->IsManagedPreference(prefs::kPdfAnnotationsEnabled) ||
          prefs->GetBoolean(prefs::kPdfAnnotationsEnabled);
-#endif
+#else
   return true;
+#endif
 }
 
 bool IsPdfInk2AnnotationsEnabled(content::BrowserContext* context) {
@@ -491,7 +497,7 @@ bool ShouldShowGlicSummarizeButton(content::WebContents* web_contents) {
     }
   }
 
-#if 0
+#if BUILDFLAG(ENABLE_ELECTRON_CHROME_PROFILE_RUNTIME)
   Profile* profile =
       Profile::FromBrowserContext(web_contents->GetBrowserContext());
   if (!glic::GlicEnabling::IsEnabledForProfile(profile)) {
