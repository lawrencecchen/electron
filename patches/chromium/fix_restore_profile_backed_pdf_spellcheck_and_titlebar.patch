From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lawrence Chen <lawrencecchen@users.noreply.github.com>
Date: Mon, 13 Jul 2026 12:43:30 +0000
Subject: [PATCH] fix: restore profile-backed PDF spellcheck and titlebar
 behavior

---
 chrome/browser/pdf/BUILD.gn                      |  1 +
 chrome/browser/pdf/chrome_pdf_stream_delegate.cc |  5 +++--
 chrome/browser/pdf/pdf_extension_util.cc         | 16 +++++++++++-----
 chrome/browser/spellchecker/BUILD.gn             |  3 ++-
 .../browser/spellchecker/spellcheck_service.cc   | 13 ++++++++-----
 chrome/browser/win/BUILD.gn                      |  1 +
 chrome/browser/win/titlebar_config.cc            |  3 ++-
 7 files changed, 28 insertions(+), 14 deletions(-)

diff --git a/chrome/browser/pdf/BUILD.gn b/chrome/browser/pdf/BUILD.gn
index 328369eb1e24c..2f6cb0179ed7f 100644
--- a/chrome/browser/pdf/BUILD.gn
+++ b/chrome/browser/pdf/BUILD.gn
@@ -40,6 +40,7 @@ source_set("pdf") {
     "//chrome/browser/resources/pdf:resources",
     "//chrome/browser/ui:browser_element_identifiers",
     "//chrome/common",
+    "//chrome/common:buildflags",
     "//components/pdf/browser:interceptors",
     "//components/pdf/common:util",
     "//components/prefs",
diff --git a/chrome/browser/pdf/chrome_pdf_stream_delegate.cc b/chrome/browser/pdf/chrome_pdf_stream_delegate.cc
index 1d7fa6c4a7956..aac220298abdb 100644
--- a/chrome/browser/pdf/chrome_pdf_stream_delegate.cc
+++ b/chrome/browser/pdf/chrome_pdf_stream_delegate.cc
@@ -15,6 +15,7 @@
 #include "base/numerics/safe_conversions.h"
